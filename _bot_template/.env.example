# Bot Template - Переменные окружения
# БД и Redis берутся из глобального .env (корень проекта)
# Здесь только специфичные для бота переменные

BOT_TOKEN=your_bot_token_here
BOT_ADMINS=123456789,987654321

# Redis databases (номера БД для этого бота)
REDIS_DB=0
REDIS_FSM_DB=1
# Или явно задайте URL для FSM:
# REDIS_FSM_URL=redis://redis:6379/1

LOG_LEVEL=INFO
