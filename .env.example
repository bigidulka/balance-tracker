# Database mode
# Production: set DATABASE_URL to Postgres DSN and keep DATABASE_USE_SQLITE=false
DATABASE_URL=
DATABASE_USE_SQLITE=false
SQLITE_DATABASE_URL=sqlite+aiosqlite:///data/balance_tracker.db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=balance_tracker
POSTGRES_USER=balance_tracker
POSTGRES_PASSWORD=change_me

# API/Auth
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTEGRATION_SECRET_KEY=change_me
TELEGRAM_ADMIN_USER_ID=6238100241

# Runtime profile flags
ENABLE_INPROCESS_REFRESH_LOOP=true
ENABLE_WORKER=false
ENABLE_LEGACY_BACKGROUND_REFRESH_LOOP=
ENABLE_INPROCESS_SYNC_WORKER=
SYNC_WORKER_POLL_INTERVAL_SECONDS=2.0
JOB_PARALLELISM=2

# Bot/API integration
BOT_TOKEN=change_me
API_TOKEN=change_me
API_ORG_ID=1
REDIS_URL=redis://redis:6379/0
ALLOWED_USERS=
HIDE_SMALL_THRESHOLD=1.0
NO_BACKEND_UI_MODE=false

# Exchange credentials (fill only what you use)
BINANCE_API_KEY=
BINANCE_SECRET=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=
BYBIT_API_KEY=
BYBIT_SECRET=
GATEIO_API_KEY=
GATEIO_SECRET=
HTX_API_KEY=
HTX_SECRET=
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSWORD=
MEXC_API_KEY=
MEXC_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BITMART_API_KEY=
BITMART_SECRET=
BITMART_UID=
POLONIEX_API_KEY=
POLONIEX_SECRET=
LBANK_API_KEY=
LBANK_SECRET=
COINEX_API_KEY=
COINEX_SECRET=
BINGX_API_KEY=
BINGX_SECRET=
XT_API_KEY=
XT_SECRET=

# Optional
OKX_WALLET_ACCOUNT_IDS=[]
OKX_WALLET_ADDRESSES=[]
OKX_WALLET_LEGACY_ENABLED=false
DEBANK_SDK_BASE_URL=http://debank-sdk:8080
DEBANK_SDK_TIMEOUT_SECONDS=30
# Canonical HTTP proxy relay for outbound exchange/wallet traffic.
# OUTBOUND_PROXY_HOST is the approved proxy hostname and must match the URL host; the bot
# container validates it before writing the proxychains config. OUTBOUND_PROXY_PORT is
# optional (defaults to the port in the URL). Never commit real proxy credentials.
OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_HOST=
OUTBOUND_PROXY_PORT=
EXCHANGE_DEFAULT_TRANSPORT=rest
EXCHANGE_TRANSPORT_OVERRIDES={"okx":"disabled"}
